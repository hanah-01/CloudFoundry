# ============================================================
# terraform.tfvars.example
# Copy to terraform.tfvars and edit for your local setup.
# NEVER commit terraform.tfvars to version control.
# ============================================================

aws_region         = "us-east-1"
project_name       = "devops-lab"
environment        = "dev"

# Networking
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "us-east-1a"

# EC2
instance_type      = "t3.micro"
ami_id             = "ami-0c55b159cbfafe1f0"
ec2_key_name       = ""             # leave empty for LocalStack

# S3 bucket name must be globally unique (LocalStack is lenient)
s3_bucket_name     = "devops-lab-artifacts-bucket"

# Security – restrict to your IP in production: "203.0.113.10/32"
admin_ssh_cidr     = "0.0.0.0/0"

# Common tags applied to every resource
common_tags = {
  Project     = "devops-lab"
  ManagedBy   = "Terraform"
  Environment = "dev"
}
